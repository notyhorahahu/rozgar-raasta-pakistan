---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import OpportunityCard from './OpportunityCard.astro';
import { getCollection } from 'astro:content';
import opportunitiesData from '../data/opportunities.json';
import { effectiveStatus, type Opportunity } from '../data/opportunities';

interface OfficialLink {
	label: string;
	href: string;
	note?: string;
}

interface Props {
	title: string;
	description: string;
	intro: string;
	oppCategories: Opportunity['category'][];
	guideCategories: string[];
	officialLinks: OfficialLink[];
	guideHeading?: string;
}

const { title, description, intro, oppCategories, guideCategories, officialLinks, guideHeading = 'Guides' } = Astro.props;

const opps = (opportunitiesData as Opportunity[]).filter((o) => oppCategories.includes(o.category));
const openOpps = opps.filter((o) => effectiveStatus(o) === 'open');
const closedOpps = opps.filter((o) => effectiveStatus(o) !== 'open');
const allGuides = (await getCollection('guides')).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const guides = allGuides.filter((g) => guideCategories.includes(g.data.category));
---

<BaseLayout title={title} description={description}>
	<section class="bg-gradient-to-b from-brand-50 to-white border-b border-line">
		<div class="max-w-7xl mx-auto px-4 py-10 md:py-12">
			<h1 class="text-3xl md:text-4xl">{title}</h1>
			<p class="mt-3 max-w-3xl text-base md:text-lg leading-relaxed">{intro}</p>
		</div>
	</section>

	<section class="max-w-7xl mx-auto px-4 py-8" aria-label="Verified opportunities">
		<h2 class="text-2xl md:text-3xl">Verified Opportunities</h2>
		{openOpps.length > 0 ? (
			<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{openOpps.map((opp) => <OpportunityCard opp={opp} />)}
			</div>
		) : (
			<div class="mt-6 rounded-xl border border-line bg-brand-50 p-5 text-sm leading-relaxed text-navy-800">
				<p class="font-semibold">No specific opening is listed here right now.</p>
				<p class="mt-2">We only list openings we have verified on the official website. Use the official portals below — they always carry the latest openings.</p>
			</div>
		)}

		{closedOpps.length > 0 && (
			<details class="mt-8 rounded-xl border border-line bg-white p-5">
				<summary class="cursor-pointer text-sm font-semibold text-navy-900">Closed / expired listings ({closedOpps.length}) — shown for reference only</summary>
				<div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{closedOpps.map((opp) => <OpportunityCard opp={opp} />)}
				</div>
			</details>
		)}
	</section>

	<section class="max-w-7xl mx-auto px-4 py-8" aria-label="Official sources">
		<h2 class="text-2xl md:text-3xl">Official Sources</h2>
		<p class="mt-2 text-sm text-muted">Always apply through the official website. Rozgar Raasta Pakistan never charges for job information.</p>
		<ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{officialLinks.map((l) => (
				<li class="rounded-xl border border-line bg-white p-4">
					<a href={l.href} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-700 hover:underline">{l.label} ↗</a>
					{l.note && <p class="mt-1 text-sm text-body">{l.note}</p>}
				</li>
			))}
		</ul>
	</section>

	{guides.length > 0 && (
		<section class="max-w-7xl mx-auto px-4 py-8" aria-label={guideHeading}>
			<h2 class="text-2xl md:text-3xl">{guideHeading}</h2>
			<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{guides.map((g) => <ArticleCard guide={g} />)}
			</div>
		</section>
	)}
</BaseLayout>
