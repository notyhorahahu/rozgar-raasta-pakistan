---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import OpportunityCard from './OpportunityCard.astro';
import { getGuides, getOpportunities } from '../lib/content';
import { effectiveStatus, jobPostingsJsonLd, type Opportunity } from '../data/opportunities';
import { breadcrumbJsonLd, organizationJsonLd } from '../data/jsonld';

interface OfficialLink {
	label: string;
	href: string;
	note?: string;
}

interface Props {
	title: string;
	description: string;
	intro: string;
	oppCategories: Opportunity['category'][];
	guideCategories: string[];
	officialLinks: OfficialLink[];
	guideHeading?: string;
	heroImage?: string;
	heroImageAlt?: string;
}

const { title, description, intro, oppCategories, guideCategories, officialLinks, guideHeading = 'Guides', heroImage, heroImageAlt } = Astro.props;

const opps = (await getOpportunities()).filter((o) => oppCategories.includes(o.category));
const openOpps = opps.filter((o) => effectiveStatus(o) === 'open');
const closedOpps = opps.filter((o) => effectiveStatus(o) === 'closed');
const unverifiedOpps = opps.filter((o) => effectiveStatus(o) === 'unverified');
const allGuides = await getGuides();
const guides = allGuides.filter((g) => guideCategories.includes(g.data.category));

const siteUrl = 'https://rozgar-raasta-pakistan.vercel.app';
const pageUrl = `${siteUrl}${Astro.url.pathname}`;
const jsonLd = [
	organizationJsonLd(siteUrl),
	breadcrumbJsonLd([
		{ name: 'Home', url: `${siteUrl}/` },
		{ name: title, url: pageUrl },
	]),
	...jobPostingsJsonLd(openOpps),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
	<section class="bg-cream hero-grid border-b border-black/10">
		<div class="max-w-7xl mx-auto px-4 py-10 md:py-12 flex flex-col md:flex-row md:items-center gap-8">
			<div class="flex-1">
				<h1 class="text-3xl md:text-4xl">{title}</h1>
				<p class="mt-3 max-w-3xl text-base md:text-lg leading-relaxed text-body">{intro}</p>
			</div>
			{heroImage && (
				<img src={heroImage} alt={heroImageAlt ?? title} loading="lazy" class="hidden md:block w-72 shrink-0 rounded-md object-cover shadow-sm aspect-[3/2]" />
			)}
		</div>
	</section>

	<section class="max-w-7xl mx-auto px-4 py-10" aria-label="Verified opportunities">
		<h2 class="text-2xl md:text-3xl">Verified Opportunities</h2>
		{openOpps.length > 0 ? (
			<div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{openOpps.map((opp) => <OpportunityCard opp={opp} />)}
			</div>
		) : (
			<div class="mt-6 border border-line bg-brand-50 p-5 text-sm leading-relaxed text-ink">
				<p class="font-bold">No specific opening is listed here right now.</p>
				<p class="mt-2">We only list openings we have verified on the official website. Use the official portals below — they always carry the latest openings.</p>
			</div>
		)}

		{closedOpps.length > 0 && (
			<details class="mt-8 rounded-md border border-line bg-white p-5">
				<summary class="cursor-pointer text-sm font-bold text-ink">Closed / expired listings ({closedOpps.length}) — shown for reference only</summary>
				<div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{closedOpps.map((opp) => <OpportunityCard opp={opp} />)}
				</div>
			</details>
		)}

		{unverifiedOpps.length > 0 && (
			<details class="mt-8 rounded-md border border-line bg-white p-5">
				<summary class="cursor-pointer text-sm font-bold text-ink">Unverified listings ({unverifiedOpps.length}) — not yet verified against the official source, shown for reference only</summary>
				<div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{unverifiedOpps.map((opp) => <OpportunityCard opp={opp} />)}
				</div>
			</details>
		)}
	</section>

	<section class="max-w-7xl mx-auto px-4 py-10" aria-label="Official sources">
		<h2 class="text-2xl md:text-3xl">Official Sources</h2>
		<p class="mt-2 text-sm text-muted">Always apply through the official website. Rozgar Raasta Pakistan never charges for job information.</p>
		<ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{officialLinks.map((l) => (
				<li class="rounded-md border border-line bg-white p-4">
					<a href={l.href} target="_blank" rel="noopener noreferrer" class="font-bold text-brand-700 hover:underline">{l.label} ↗</a>
					{l.note && <p class="mt-1 text-sm text-body">{l.note}</p>}
				</li>
			))}
		</ul>
	</section>

	{guides.length > 0 && (
		<section class="max-w-7xl mx-auto px-4 py-10" aria-label={guideHeading}>
			<h2 class="text-2xl md:text-3xl">{guideHeading}</h2>
			<div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{guides.map((g) => <ArticleCard guide={g} />)}
			</div>
		</section>
	)}
</BaseLayout>
