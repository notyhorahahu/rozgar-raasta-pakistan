---
export type Category =
	| 'government'
	| 'private'
	| 'remote'
	| 'earning'
	| 'freelancing'
	| 'scholarship'
	| 'internship'
	| 'course'
	| 'ai-tools'
	| 'career'
	| 'student'
	| 'skills'
	| 'business';

interface Props {
	category: string;
	label: string;
	class?: string;
}

const { category, label, class: className = '' } = Astro.props;

const styles: Record<string, { bg: string; icon: string }> = {
	'government': { bg: 'from-navy-800 to-navy-950', icon: '🏛️' },
	'private': { bg: 'from-blue-700 to-navy-900', icon: '💼' },
	'remote': { bg: 'from-sky-600 to-navy-800', icon: '🌐' },
	'earning': { bg: 'from-emerald-600 to-navy-900', icon: '💰' },
	'freelancing': { bg: 'from-indigo-600 to-navy-900', icon: '💻' },
	'scholarship': { bg: 'from-amber-600 to-navy-900', icon: '🎓' },
	'internship': { bg: 'from-teal-600 to-navy-900', icon: '🧑‍💼' },
	'course': { bg: 'from-blue-600 to-indigo-900', icon: '📚' },
	'ai-tools': { bg: 'from-violet-600 to-navy-900', icon: '🤖' },
	'career': { bg: 'from-slate-700 to-navy-900', icon: '📈' },
	'student': { bg: 'from-cyan-600 to-navy-900', icon: '🎒' },
	'skills': { bg: 'from-blue-500 to-navy-800', icon: '🛠️' },
	'business': { bg: 'from-orange-600 to-navy-900', icon: '🚀' },
};

const style = styles[category] ?? styles['career'];
---

<div class={`relative overflow-hidden bg-gradient-to-br ${style.bg} ${className}`} role="img" aria-label={`${label} — Rozgar Raasta Pakistan`}>
	<div class="absolute inset-0 opacity-10" aria-hidden="true">
		<svg width="100%" height="100%"><defs><pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.5" fill="#fff" /></pattern></defs><rect width="100%" height="100%" fill="url(#dots)" /></svg>
	</div>
	<div class="relative flex h-full flex-col items-start justify-end p-4">
		<span class="text-3xl" aria-hidden="true">{style.icon}</span>
		<span class="mt-2 text-xs font-semibold uppercase tracking-wider text-white/80">Rozgar Raasta Pakistan</span>
		<span class="text-base font-bold leading-snug text-white">{label}</span>
	</div>
</div>
