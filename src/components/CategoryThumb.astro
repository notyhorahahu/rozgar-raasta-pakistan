---
interface Props {
	category: string;
	label: string;
	class?: string;
}

const { category, label, class: className = '' } = Astro.props;

// Original AI-generated photo for this category (falls back to the nearest
// category photo where no dedicated image exists). The dark gradient overlay
// keeps the white label text readable.
const images: Record<string, string> = {
	'freelancing': '/images/cat-freelancing.jpg',
	'career': '/images/cat-career.jpg',
	'student': '/images/cat-student.jpg',
	'skills': '/images/cat-skills.jpg',
	'earning': '/images/cat-earning.jpg',
	'business': '/images/cat-business.jpg',
	'ai-tools': '/images/cat-ai-tools.jpg',
	'scholarship': '/images/cat-student.jpg',
	'course': '/images/cat-skills.jpg',
	'government': '/images/cat-career.jpg',
	'private': '/images/cat-career.jpg',
	'remote': '/images/cat-freelancing.jpg',
	'internship': '/images/cat-career.jpg',
};

const image = images[category] ?? images['career'];
---

<div class={`relative overflow-hidden bg-grey-bg ${className}`} role="img" aria-label={`${label} — Rozgar Raasta Pakistan`}>
	<img src={image} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
	<div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/30 to-black/5" aria-hidden="true"></div>
	<div class="relative flex h-full flex-col items-start justify-end p-4">
		<span class="text-base font-bold leading-snug text-white">{label}</span>
	</div>
</div>
