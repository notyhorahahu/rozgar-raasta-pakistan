---
import CategoryThumb from './CategoryThumb.astro';
import { CATEGORY_LABELS, effectiveStatus, formatDate, type Opportunity } from '../data/opportunities';

interface Props {
	opp: Opportunity;
}

const { opp } = Astro.props;
const status = effectiveStatus(opp);
const statusStyle =
	status === 'open'
		? 'bg-emerald-100 text-emerald-800'
		: status === 'closed'
			? 'bg-red-100 text-red-800'
			: 'bg-amber-100 text-amber-800';
const statusText = status === 'open' ? 'Open' : status === 'closed' ? 'Closed' : 'Unverified';
const domain = (() => {
	try {
		return new URL(opp.sourceUrl).hostname;
	} catch {
		return opp.sourceUrl;
	}
})();
---

<article class="flex flex-col overflow-hidden rounded-xl border border-line bg-white shadow-sm transition hover:shadow-md">
	<CategoryThumb category={opp.category} label={opp.title} class="aspect-[16/9] w-full" />
	<div class="flex flex-1 flex-col p-5">
		<div class="flex flex-wrap items-center gap-2 text-xs">
			<span class={`rounded-full px-2.5 py-1 font-semibold ${statusStyle}`}>{statusText}</span>
			<span class="rounded-full bg-brand-50 px-2.5 py-1 font-semibold text-brand-700">{CATEGORY_LABELS[opp.category]}</span>
		</div>
		<h3 class="mt-3 text-lg font-bold leading-snug text-navy-900">{opp.title}</h3>
		<p class="mt-1 text-sm font-medium text-navy-700">{opp.organization} · {opp.location}</p>
		<dl class="mt-3 space-y-1.5 text-sm text-body">
			<div class="flex gap-2"><dt class="w-24 shrink-0 font-semibold text-navy-900">Deadline:</dt><dd>{formatDate(opp.deadline)}</dd></div>
			<div class="flex gap-2"><dt class="w-24 shrink-0 font-semibold text-navy-900">Eligibility:</dt><dd class="line-clamp-2">{opp.eligibility}</dd></div>
			<div class="flex gap-2"><dt class="w-24 shrink-0 font-semibold text-navy-900">Fees:</dt><dd>{opp.fees}</dd></div>
		</dl>
		<div class="mt-4 flex items-center justify-between gap-3 border-t border-line pt-4">
			<span class="text-xs text-muted">Verified {opp.verifiedDate} · Source: {domain}</span>
		</div>
		<a
			href={opp.sourceUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="mt-3 inline-flex items-center justify-center gap-1 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700"
		>
			Apply on official site <span aria-hidden="true">↗</span>
		</a>
		<p class="mt-2 text-xs text-muted">Always confirm the deadline and requirements on the official page before applying.</p>
	</div>
</article>
