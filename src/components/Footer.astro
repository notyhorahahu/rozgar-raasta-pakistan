---
const navLinks = [
	{ label: 'Home', href: '/' },
	{ label: 'Opportunities', href: '/opportunities' },
	{ label: 'Government Jobs', href: '/jobs/government' },
	{ label: 'Guides', href: '/guides' },
	{ label: 'CV Builder', href: '/cv-builder' },
	{ label: 'Contact Us', href: '/contact' },
];
const companyLinks = [
	{ label: 'Privacy Policy', href: '/privacy' },
	{ label: 'Terms & Conditions', href: '/terms' },
	{ label: 'Disclaimer', href: '/disclaimer' },
	{ label: 'Editorial Policy', href: '/editorial-policy' },
	{ label: 'Corrections Policy', href: '/corrections-policy' },
	{ label: 'Advertise With Us', href: '/advertise' },
];
const learnLinks = [
	{ label: 'Freelancing', href: '/freelancing' },
	{ label: 'Skills & Courses', href: '/skills' },
	{ label: 'Online Earning', href: '/earning' },
	{ label: 'AI Tools', href: '/ai-tools' },
	{ label: 'Scholarships', href: '/scholarships' },
	{ label: 'Student Guides', href: '/student-guides' },
];
const year = new Date().getFullYear();
---

<!-- Newsletter -->
<section class="border-t border-line bg-white" aria-label="Newsletter">
	<div class="max-w-7xl mx-auto px-4 py-10 grid gap-6 md:grid-cols-2 md:items-center">
		<div>
			<h2 class="text-ink text-2xl font-extrabold">Get new opportunities in your inbox</h2>
			<p class="mt-2 text-sm text-body">One weekly email with verified jobs, scholarships and free courses. No spam, no selling your data. Unsubscribe anytime.</p>
		</div>
		<form id="newsletter-form" class="flex flex-col sm:flex-row gap-0" novalidate>
			<label for="newsletter-email" class="sr-only">Email address</label>
			<input
				id="newsletter-email"
				type="email"
				name="email"
				required
				placeholder="Your email address"
				class="flex-1 border border-line border-b-0 sm:border-b sm:border-r-0 bg-white px-4 py-3 text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-brand-600"
			/>
			<button type="submit" class="bg-brand-600 px-6 py-3 text-sm font-bold text-white hover:bg-brand-700">Subscribe</button>
		</form>
		<p id="newsletter-msg" class="md:col-span-2 text-sm text-emerald-700 hidden" role="status"></p>
	</div>
</section>

<footer class="bg-[#101010] text-[#9a9a9a]">
	<div class="max-w-7xl mx-auto px-4 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
		<div>
			<a href="/" class="flex items-center gap-2.5">
				<img src="/logo-mark.svg" alt="" class="h-9 w-9 shrink-0" width="36" height="36" />
				<span class="text-base font-extrabold leading-none text-white">Rozgar Raasta Pakistan</span>
			</a>
			<p class="mt-4 text-sm leading-relaxed">
				Learn Skills. Find Opportunities. Build Your Future. Genuine jobs, free courses, scholarships and practical career guidance for Pakistanis.
			</p>
			<p class="mt-3 text-xs">We never charge for job listings and never ask for CNIC or bank details.</p>
			<div class="mt-5 flex items-center gap-3">
				<a href="https://www.facebook.com/profile.php?id=61596652844442" target="_blank" rel="noopener noreferrer" aria-label="Rozgar Raasta Pakistan on Facebook" class="text-white hover:text-brand-500">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
				</a>
				<a href="https://www.pinterest.com/calchub_/" target="_blank" rel="noopener noreferrer" aria-label="Rozgar Raasta Pakistan on Pinterest" class="text-white hover:text-brand-500">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.749-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.987C24.007 5.367 18.641 0 12.017 0z"/></svg>
				</a>
			</div>
		</div>
		<nav aria-label="Navigation">
			<h3 class="text-white font-bold mb-4">Navigation</h3>
			<ul class="space-y-2.5 text-sm">
				{navLinks.map((l) => <li><a href={l.href} class="text-[#9a9a9a] hover:text-white">{l.label}</a></li>)}
			</ul>
		</nav>
		<nav aria-label="Company">
			<h3 class="text-white font-bold mb-4">Company</h3>
			<ul class="space-y-2.5 text-sm">
				{companyLinks.map((l) => <li><a href={l.href} class="text-[#9a9a9a] hover:text-white">{l.label}</a></li>)}
			</ul>
		</nav>
		<nav aria-label="Learning">
			<h3 class="text-white font-bold mb-4">Learning</h3>
			<ul class="space-y-2.5 text-sm">
				{learnLinks.map((l) => <li><a href={l.href} class="text-[#9a9a9a] hover:text-white">{l.label}</a></li>)}
			</ul>
		</nav>
	</div>

	<div class="border-t border-white/10">
		<div class="max-w-7xl mx-auto px-4 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
			<p>All opportunities are verified against official sources. Always confirm details on the official website before applying.</p>
			<p>Copyright © {year} Rozgar Raasta Pakistan</p>
		</div>
	</div>
</footer>

<script>
	const form = document.getElementById('newsletter-form');
	const msg = document.getElementById('newsletter-msg');
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const input = document.getElementById('newsletter-email');
		const email = (input as HTMLInputElement)?.value.trim() ?? '';
		if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
			if (msg) {
				msg.textContent = 'Please enter a valid email address.';
				msg.classList.remove('hidden');
				msg.classList.add('text-red-600');
				msg.classList.remove('text-emerald-700');
			}
			return;
		}
		try {
			const list = JSON.parse(localStorage.getItem('rrp-newsletter') || '[]');
			if (!list.includes(email)) list.push(email);
			localStorage.setItem('rrp-newsletter', JSON.stringify(list));
		} catch {}
		if (msg) {
			msg.textContent = 'Thank you! You are subscribed. We will email you once a week with verified opportunities.';
			msg.classList.remove('hidden', 'text-red-600');
			msg.classList.add('text-emerald-700');
		}
		(input as HTMLInputElement).value = '';
	});
</script>
