---
import CategoryThumb from './CategoryThumb.astro';
import type { CollectionEntry } from 'astro:content';
import { slugOf } from '../data/guides';

interface Props {
	guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { title, description, category, date, updated } = guide.data;
const href = `/guides/${slugOf(guide)}`;
const shown = new Date(updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<article class="group flex flex-col overflow-hidden rounded-xl border border-line bg-white shadow-sm transition hover:shadow-md">
	<a href={href} class="block" tabindex="-1" aria-hidden="true">
		<CategoryThumb category={category} label={title} class="aspect-[16/9] w-full" />
	</a>
	<div class="flex flex-1 flex-col p-5">
		<div class="flex items-center gap-2 text-xs">
			<span class="rounded-full bg-brand-50 px-2.5 py-1 font-semibold capitalize text-brand-700">{category.replace('-', ' ')}</span>
			<time datetime={new Date(updated).toISOString()} class="text-muted">{shown}</time>
		</div>
		<h3 class="mt-3 text-lg font-bold leading-snug text-navy-900">
			<a href={href} class="group-hover:text-brand-700 group-hover:underline">{title}</a>
		</h3>
		<p class="mt-2 flex-1 text-sm leading-relaxed text-body line-clamp-3">{description}</p>
		<a href={href} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:underline">
			Read guide <span aria-hidden="true">→</span>
		</a>
	</div>
</article>
