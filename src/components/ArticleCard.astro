---
import CategoryThumb from './CategoryThumb.astro';
import type { CollectionEntry } from 'astro:content';
import { slugOf } from '../data/guides';

interface Props {
	guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { title, description, category, updated } = guide.data;
const href = `/guides/${slugOf(guide)}`;
const shown = new Date(updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<article class="group flex min-w-0 flex-col overflow-hidden rounded-md border border-line bg-white shadow-[0_2px_10px_rgba(0,0,0,0.06)] transition hover:shadow-[0_8px_24px_rgba(0,0,0,0.10)]">
	<a href={href} class="block" tabindex="-1" aria-hidden="true">
		<CategoryThumb category={category} label={title} class="aspect-[16/9] w-full" />
	</a>
	<div class="flex flex-1 flex-col p-5">
		<div class="flex items-center gap-2 text-xs">
			<span class="bg-brand-50 px-2.5 py-1 font-bold capitalize text-brand-700">{category.replace('-', ' ')}</span>
			<time datetime={new Date(updated).toISOString()} class="text-muted">{shown}</time>
		</div>
		<h3 class="mt-3 text-lg font-extrabold leading-snug text-ink">
			<a href={href} class="text-ink group-hover:text-brand-700 group-hover:underline">{title}</a>
		</h3>
		<p class="mt-2 flex-1 text-sm leading-relaxed text-body line-clamp-3">{description}</p>
		<a href={href} class="mt-4 flex items-center justify-center bg-brand-600 px-4 py-3 text-sm font-bold text-white hover:bg-brand-700">
			Read guide
		</a>
	</div>
</article>
