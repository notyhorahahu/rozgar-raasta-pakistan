---
const navItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Browse Jobs', href: '/opportunities' },
	{ label: 'Scholarships', href: '/scholarships' },
	{ label: 'Guides', href: '/guides' },
	{ label: 'CV Builder', href: '/cv-builder' },
];

const moreLinks = [
	{ label: 'Government Jobs', href: '/jobs/government' },
	{ label: 'Private Jobs', href: '/jobs/private' },
	{ label: 'Remote Jobs', href: '/jobs/remote' },
	{ label: 'Internships', href: '/internships' },
	{ label: 'Freelancing', href: '/freelancing' },
	{ label: 'Skills & Courses', href: '/skills' },
	{ label: 'Online Earning', href: '/earning' },
	{ label: 'Student Guides', href: '/student-guides' },
	{ label: 'Business Guides', href: '/business-guides' },
	{ label: 'Career Preparation', href: '/career-preparation' },
	{ label: 'AI Tools', href: '/ai-tools' },
	{ label: 'About Us', href: '/about' },
	{ label: 'Contact Us', href: '/contact' },
	{ label: 'Advertise With Us', href: '/advertise' },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? current === '/' : current === href || current.startsWith(href + '/');
---

<header class="bg-cream border-b border-black/10">
	<div class="max-w-7xl mx-auto px-4">
		<div class="flex items-center justify-between gap-4 py-4">
			<a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="Rozgar Raasta Pakistan — Home">
				<img src="/logo-mark.svg" alt="" class="h-9 w-9 shrink-0" width="36" height="36" />
				<span class="text-[15px] sm:text-lg font-extrabold leading-none text-ink">Rozgar Raasta Pakistan</span>
			</a>

			<nav class="hidden lg:block" aria-label="Main navigation">
				<ul class="flex items-center gap-7">
					{navItems.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? 'page' : undefined}
								class={`text-sm ${isActive(item.href) ? 'font-bold text-ink border-b-[3px] border-brand-600 pb-1' : 'font-medium text-muted hover:text-ink'}`}
							>
								{item.label}
							</a>
						</li>
					))}
					<li class="relative group">
						<button type="button" class="text-sm font-medium text-muted hover:text-ink" aria-haspopup="true">
							More ▾
						</button>
						<ul class="absolute left-1/2 -translate-x-1/2 top-full hidden group-hover:block group-focus-within:block bg-white border border-line shadow-lg py-2 w-56 z-50">
							{moreLinks.map((item) => (
								<li>
									<a href={item.href} class="block px-4 py-2 text-sm font-medium text-ink hover:bg-cream hover:text-brand-700">{item.label}</a>
								</li>
							))}
						</ul>
					</li>
				</ul>
			</nav>

			<div class="flex items-center gap-5">
				<a href="/cv-builder" class="hidden md:inline-block text-sm font-bold text-ink hover:text-brand-700">CV Builder</a>
				<a href="/opportunities" class="hidden sm:inline-block bg-brand-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-brand-700">Find Jobs</a>
				<a href="/search" class="lg:hidden p-2 text-ink" aria-label="Search">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="M21 21l-4.3-4.3" /></svg>
				</a>
				<button
					id="menu-btn"
					type="button"
					class="p-2 text-ink lg:hidden"
					aria-expanded="false"
					aria-controls="mobile-menu"
					aria-label="Open menu"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Mobile menu -->
	<div id="mobile-menu" class="hidden lg:hidden border-t border-black/10 bg-cream" aria-label="Mobile navigation">
		<div class="max-w-7xl mx-auto px-4 py-4">
			<form action="/search" method="get" role="search" class="flex items-center">
				<label for="mobile-search" class="sr-only">Search jobs, courses and guides</label>
				<input id="mobile-search" type="search" name="q" placeholder="Find your dream job" class="w-full border border-line border-r-0 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
				<button type="submit" class="bg-brand-600 px-5 py-2.5 text-sm font-bold text-white">Go</button>
			</form>
			<ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-1">
				{[...navItems, ...moreLinks].map((item) => (
					<li>
						<a href={item.href} class={`block px-3 py-2 text-sm font-medium ${isActive(item.href) ? 'font-bold text-brand-700' : 'text-ink hover:text-brand-700'}`}>{item.label}</a>
					</li>
				))}
			</ul>
			<a href="/opportunities" class="mt-4 block bg-brand-600 px-5 py-3 text-center text-sm font-bold text-white">Find Jobs</a>
		</div>
	</div>
</header>

<script>
	const btn = document.getElementById('menu-btn');
	const menu = document.getElementById('mobile-menu');
	btn?.addEventListener('click', () => {
		const open = menu?.classList.toggle('hidden');
		btn.setAttribute('aria-expanded', open ? 'false' : 'true');
		btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
	});
</script>
