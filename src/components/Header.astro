---
const navGroups = [
	{ label: 'Home', href: '/' },
	{ label: 'Opportunities', href: '/opportunities' },
	{ label: 'Government Jobs', href: '/jobs/government' },
	{ label: 'Private Jobs', href: '/jobs/private' },
	{ label: 'Remote Jobs', href: '/jobs/remote' },
	{ label: 'Freelancing', href: '/freelancing' },
	{ label: 'Skills & Courses', href: '/skills' },
	{ label: 'Scholarships', href: '/scholarships' },
	{ label: 'Internships', href: '/internships' },
	{ label: 'AI Tools', href: '/ai-tools' },
	{ label: 'Guides', href: '/guides' },
	{ label: 'CV Builder', href: '/cv-builder' },
];

const moreLinks = [
	{ label: 'Online Earning', href: '/earning' },
	{ label: 'Student Guides', href: '/student-guides' },
	{ label: 'Business Guides', href: '/business-guides' },
	{ label: 'Career Preparation', href: '/career-preparation' },
	{ label: 'About Us', href: '/about' },
	{ label: 'Contact Us', href: '/contact' },
	{ label: 'Advertise With Us', href: '/advertise' },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? current === '/' : current === href || current.startsWith(href + '/');
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-line shadow-sm">
	<!-- Top bar -->
	<div class="bg-navy-900 text-white text-xs">
		<div class="max-w-7xl mx-auto px-4 py-1.5 flex items-center justify-between gap-4">
			<p class="truncate">Learn Skills. Find Opportunities. Build Your Future.</p>
			<div class="hidden sm:flex items-center gap-4 shrink-0">
				<a href="/about" class="text-white/80 hover:text-white">About</a>
				<a href="/contact" class="text-white/80 hover:text-white">Contact</a>
				<a href="/advertise" class="text-white/80 hover:text-white">Advertise</a>
			</div>
		</div>
	</div>

	<!-- Main bar -->
	<div class="max-w-7xl mx-auto px-4">
		<div class="flex items-center justify-between gap-4 py-3">
			<a href="/" class="flex items-center gap-2 shrink-0" aria-label="Rozgar Raasta Pakistan — Home">
				<img src="/logo.svg" alt="Rozgar Raasta Pakistan" class="h-10 w-auto" width="240" height="64" />
			</a>

			<form action="/search" method="get" role="search" class="hidden lg:flex flex-1 max-w-md items-center">
				<label for="header-search" class="sr-only">Search opportunities and guides</label>
				<input
					id="header-search"
					type="search"
					name="q"
					placeholder="Search jobs, courses, guides..."
					class="w-full rounded-l-lg border border-line border-r-0 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600"
				/>
				<button type="submit" class="rounded-r-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Search</button>
			</form>

			<div class="flex items-center gap-2">
				<a href="/search" class="lg:hidden rounded-lg border border-line p-2 text-navy-900" aria-label="Search">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="M21 21l-4.3-4.3" /></svg>
				</a>
				<button
					id="menu-btn"
					type="button"
					class="rounded-lg border border-line p-2 text-navy-900 lg:hidden"
					aria-expanded="false"
					aria-controls="mobile-menu"
					aria-label="Open menu"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Desktop nav -->
	<nav class="hidden lg:block border-t border-line" aria-label="Main navigation">
		<div class="max-w-7xl mx-auto px-4">
			<ul class="flex flex-wrap items-center gap-x-1">
				{navGroups.map((item) => (
					<li>
						<a
							href={item.href}
							aria-current={isActive(item.href) ? 'page' : undefined}
							class={`block px-3 py-2.5 text-sm font-medium rounded-md ${isActive(item.href) ? 'text-brand-700 bg-brand-50' : 'text-navy-900 hover:text-brand-700 hover:bg-brand-50'}`}
						>
							{item.label}
						</a>
					</li>
				))}
				<li class="relative group">
					<button type="button" class="block px-3 py-2.5 text-sm font-medium text-navy-900 hover:text-brand-700 hover:bg-brand-50 rounded-md" aria-haspopup="true">
						More ▾
					</button>
					<ul class="absolute right-0 top-full hidden group-hover:block group-focus-within:block bg-white border border-line rounded-lg shadow-lg py-2 w-56 z-50">
						{moreLinks.map((item) => (
							<li>
								<a href={item.href} class="block px-4 py-2 text-sm text-navy-900 hover:bg-brand-50 hover:text-brand-700">{item.label}</a>
							</li>
						))}
					</ul>
				</li>
			</ul>
		</div>
	</nav>

	<!-- Mobile menu -->
	<div id="mobile-menu" class="hidden lg:hidden border-t border-line bg-white" aria-label="Mobile navigation">
		<div class="max-w-7xl mx-auto px-4 py-3">
			<form action="/search" method="get" role="search" class="flex items-center mb-3">
				<label for="mobile-search" class="sr-only">Search opportunities and guides</label>
				<input id="mobile-search" type="search" name="q" placeholder="Search jobs, courses, guides..." class="w-full rounded-l-lg border border-line border-r-0 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
				<button type="submit" class="rounded-r-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Search</button>
			</form>
			<ul class="grid grid-cols-1 sm:grid-cols-2 gap-1">
				{[...navGroups, ...moreLinks].map((item) => (
					<li>
						<a href={item.href} class={`block px-3 py-2 rounded-md text-sm font-medium ${isActive(item.href) ? 'text-brand-700 bg-brand-50' : 'text-navy-900 hover:bg-brand-50'}`}>{item.label}</a>
					</li>
				))}
			</ul>
		</div>
	</div>
</header>

<script>
	const btn = document.getElementById('menu-btn');
	const menu = document.getElementById('mobile-menu');
	btn?.addEventListener('click', () => {
		const open = menu?.classList.toggle('hidden');
		btn.setAttribute('aria-expanded', open ? 'false' : 'true');
		btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
	});
</script>
