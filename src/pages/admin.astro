---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import opportunitiesData from '../data/opportunities.json';
import { effectiveStatus, type Opportunity } from '../data/opportunities';

const guides = await getCollection('guides');
const opps = opportunitiesData as Opportunity[];
const openOpps = opps.filter((o) => effectiveStatus(o) === 'open');
const closedOpps = opps.filter((o) => effectiveStatus(o) !== 'open');
const byCat: Record<string, number> = {};
for (const o of opps) byCat[o.category] = (byCat[o.category] ?? 0) + 1;
const byGuideCat: Record<string, number> = {};
for (const g of guides) byGuideCat[g.data.category] = (byGuideCat[g.data.category] ?? 0) + 1;
---
<BaseLayout title="Admin Dashboard" description="Rozgar Raasta Pakistan admin dashboard — content counts and traffic. Analytics not yet connected; numbers shown are real content counts only." noindex={true}>
	<section class="max-w-7xl mx-auto px-4 py-10">
		<h1 class="text-3xl md:text-4xl">Admin Dashboard</h1>
		<p class="mt-2 text-sm text-muted">Content counts are real. Traffic and earnings are not shown because Google Analytics and AdSense are not connected yet — we never fabricate numbers.</p>

		<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			<div class="rounded-md border border-line bg-white p-5 shadow-sm"><p class="text-3xl font-bold text-navy-900">{guides.length}</p><p class="mt-1 text-sm text-muted">Published guides</p></div>
			<div class="rounded-md border border-line bg-white p-5 shadow-sm"><p class="text-3xl font-bold text-navy-900">{opps.length}</p><p class="mt-1 text-sm text-muted">Opportunity listings</p></div>
			<div class="rounded-md border border-line bg-white p-5 shadow-sm"><p class="text-3xl font-bold text-emerald-700">{openOpps.length}</p><p class="mt-1 text-sm text-muted">Open opportunities</p></div>
			<div class="rounded-md border border-line bg-white p-5 shadow-sm"><p class="text-3xl font-bold text-red-700">{closedOpps.length}</p><p class="mt-1 text-sm text-muted">Closed opportunities</p></div>
		</div>

		<div class="mt-8 grid gap-6 lg:grid-cols-2">
			<div class="rounded-md border border-line bg-white p-6 shadow-sm">
				<h2 class="text-xl">Opportunities by category</h2>
				<ul class="mt-4 space-y-2 text-sm">
					{Object.entries(byCat).sort((a, b) => b[1] - a[1]).map(([cat, n]) => (
						<li class="flex justify-between border-b border-line pb-2"><span class="capitalize">{cat.replace('-', ' ')}</span><strong>{n}</strong></li>
					))}
				</ul>
			</div>
			<div class="rounded-md border border-line bg-white p-6 shadow-sm">
				<h2 class="text-xl">Guides by category</h2>
				<ul class="mt-4 space-y-2 text-sm">
					{Object.entries(byGuideCat).sort((a, b) => b[1] - a[1]).map(([cat, n]) => (
						<li class="flex justify-between border-b border-line pb-2"><span class="capitalize">{cat.replace('-', ' ')}</span><strong>{n}</strong></li>
					))}
				</ul>
			</div>
		</div>

		<div class="mt-8 grid gap-6 lg:grid-cols-2">
			<div class="rounded-md border border-dashed border-line bg-brand-50 p-6">
				<h2 class="text-xl">Traffic — not connected</h2>
				<p class="mt-2 text-sm leading-relaxed">Google Analytics is not connected yet. Daily visitors, page views and traffic sources will appear here once the GA4 measurement ID is added to the site configuration. No numbers are shown until then.</p>
				<p class="mt-3 text-sm"><a href="/docs/analytics-setup" class="font-semibold text-brand-700 hover:underline">See analytics setup steps →</a></p>
			</div>
			<div class="rounded-md border border-dashed border-line bg-brand-50 p-6">
				<h2 class="text-xl">AdSense — not applied</h2>
				<p class="mt-2 text-sm leading-relaxed">AdSense has not been applied for. Impressions, CTR, RPM and earnings will appear here only after approval and after the official ad code is added. We never show fabricated earnings.</p>
				<p class="mt-3 text-sm"><a href="/docs/adsense-readiness" class="font-semibold text-brand-700 hover:underline">See AdSense readiness audit →</a></p>
			</div>
		</div>

		<div class="mt-8 rounded-md border border-line bg-white p-6 shadow-sm">
			<h2 class="text-xl">Content management</h2>
			<p class="mt-2 text-sm leading-relaxed">Guides live in <code class="rounded bg-brand-50 px-1.5 py-0.5 text-xs">src/content/guides/</code> as Markdown. Opportunities live in <code class="rounded bg-brand-50 px-1.5 py-0.5 text-xs">src/data/opportunities.json</code>. Edit a file, commit, and Vercel rebuilds the site automatically. Expired opportunities are marked Closed automatically by their deadline.</p>
			<div class="mt-4 flex flex-wrap gap-3">
				<a href="/guides" class=" bg-brand-600 px-4 py-2 text-sm font-semibold text-white">View all guides</a>
				<a href="/opportunities" class=" border border-line bg-white px-4 py-2 text-sm font-semibold text-navy-900">View all opportunities</a>
				<a href="/sitemap-index.xml" class=" border border-line bg-white px-4 py-2 text-sm font-semibold text-navy-900">Sitemap</a>
				<a href="/rss.xml" class=" border border-line bg-white px-4 py-2 text-sm font-semibold text-navy-900">RSS feed</a>
			</div>
		</div>
	</section>
</BaseLayout>
