---
import CategoryPage from '../components/CategoryPage.astro';
import OpportunityCard from '../components/OpportunityCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import opportunitiesData from '../data/opportunities.json';
import { effectiveStatus, type Opportunity } from '../data/opportunities';
const opps = opportunitiesData as Opportunity[];
const openOpps = opps.filter((o) => effectiveStatus(o) === 'open');
---
<BaseLayout title="Latest Opportunities" description="All verified jobs, courses, scholarships and internships in Pakistan — checked against official sources.">
	<section class="bg-gradient-to-b from-brand-50 to-white border-b border-line">
		<div class="max-w-7xl mx-auto px-4 py-10 md:py-12">
			<h1 class="text-3xl md:text-4xl">Latest Opportunities</h1>
			<p class="mt-3 max-w-3xl text-base md:text-lg leading-relaxed">Every verified opportunity in one place — government jobs, private jobs, remote work, free courses, scholarships and internships. We never list an expired opening as active.</p>
		</div>
	</section>
	<section class="max-w-7xl mx-auto px-4 py-8">
		<div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
			<a href="/opportunities" class="rounded-full bg-navy-900 px-4 py-2 text-sm font-semibold text-white">All</a>
			<a href="/jobs/government" class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-navy-900 hover:border-brand-600">Government</a>
			<a href="/jobs/private" class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-navy-900 hover:border-brand-600">Private</a>
			<a href="/jobs/remote" class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-navy-900 hover:border-brand-600">Remote</a>
			<a href="/skills" class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-navy-900 hover:border-brand-600">Courses</a>
			<a href="/scholarships" class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-navy-900 hover:border-brand-600">Scholarships</a>
			<a href="/internships" class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-navy-900 hover:border-brand-600">Internships</a>
		</div>
		{openOpps.length > 0 ? (
			<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{openOpps.map((opp) => <OpportunityCard opp={opp} />)}
			</div>
		) : (
			<p class="mt-6 rounded-xl border border-line bg-brand-50 p-5 text-sm text-navy-800">No specific opening is verified right now. Check the official portals: <a href="https://jobs.gov.pk/" target="_blank" rel="noopener" class="font-semibold underline">jobs.gov.pk</a> · <a href="https://njp.gov.pk/" target="_blank" rel="noopener" class="font-semibold underline">njp.gov.pk</a> · <a href="https://www.ppsc.gop.pk/" target="_blank" rel="noopener" class="font-semibold underline">ppsc.gop.pk</a> · <a href="https://www.fpsc.gov.pk/" target="_blank" rel="noopener" class="font-semibold underline">fpsc.gov.pk</a></p>
		)}
	</section>
</BaseLayout>
