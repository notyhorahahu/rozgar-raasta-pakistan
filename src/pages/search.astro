---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search verified jobs, courses, scholarships and guides on Rozgar Raasta Pakistan.">
	<section class="bg-gradient-to-b from-brand-50 to-white border-b border-line">
		<div class="max-w-7xl mx-auto px-4 py-10 md:py-12">
			<h1 class="text-3xl md:text-4xl">Search</h1>
			<form id="search-form" action="/search" method="get" role="search" class="mt-6 flex max-w-xl items-center">
				<label for="search-input" class="sr-only">Search jobs, courses and guides</label>
				<input id="search-input" type="search" name="q" placeholder="Search jobs, courses, guides..." class="w-full rounded-l-xl border border-line border-r-0 px-5 py-3.5 text-base shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
				<button type="submit" class="rounded-r-xl bg-brand-600 px-6 py-3.5 text-base font-semibold text-white hover:bg-brand-700">Search</button>
			</form>
			<p id="search-status" class="mt-4 text-sm text-muted" role="status"></p>
		</div>
	</section>
	<section class="max-w-7xl mx-auto px-4 py-8">
		<div id="popular-searches">
			<h2 class="text-2xl">Popular searches</h2>
			<div class="mt-4 flex flex-wrap gap-2">
				{['PPSC', 'FPSC', 'DigiSkills', 'Fiverr', 'scholarship', 'internship', 'CV', 'free courses', 'remote jobs'].map((term) => (
					<a href={`/search?q=${encodeURIComponent(term)}`} class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-navy-900 hover:border-brand-600">{term}</a>
				))}
			</div>
		</div>
		<div id="search-results" class="hidden">
			<div id="opp-results"></div>
			<div id="guide-results" class="mt-10"></div>
			<div id="no-results" class="hidden rounded-xl border border-line bg-brand-50 p-6 text-sm leading-relaxed text-navy-800">
				<p class="font-semibold" id="no-results-title">No results.</p>
				<p class="mt-2">Try a broader term, for example “jobs”, “courses” or “freelancing”. Or browse the categories: <a href="/jobs/government" class="font-semibold underline">Government Jobs</a> · <a href="/freelancing" class="font-semibold underline">Freelancing</a> · <a href="/skills" class="font-semibold underline">Free Courses</a>.</p>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const input = document.getElementById('search-input');
	const statusEl = document.getElementById('search-status');
	const popularEl = document.getElementById('popular-searches');
	const resultsEl = document.getElementById('search-results');
	const oppEl = document.getElementById('opp-results');
	const guideEl = document.getElementById('guide-results');
	const noEl = document.getElementById('no-results');
	const noTitle = document.getElementById('no-results-title');

	function esc(s) {
		return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
	}

	function card(item) {
		const badge = item.type === 'guide' ? 'Guide' : 'Opportunity';
		const link = item.external
			? `<a href="${esc(item.url)}" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center justify-center gap-1 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">Apply on official site ↗</a>`
			: `<a href="${esc(item.url)}" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:underline">Read guide →</a>`;
		return `<article class="flex flex-col rounded-xl border border-line bg-white p-5 shadow-sm">
			<div class="flex items-center gap-2 text-xs">
				<span class="rounded-full bg-brand-50 px-2.5 py-1 font-semibold capitalize text-brand-700">${esc(item.category.replace('-', ' '))}</span>
				<span class="rounded-full bg-slate-100 px-2.5 py-1 font-semibold text-slate-600">${badge}</span>
			</div>
			<h3 class="mt-3 text-lg font-bold leading-snug text-navy-900"><a href="${esc(item.url)}" ${item.external ? 'target="_blank" rel="noopener noreferrer"' : ''} class="hover:text-brand-700 hover:underline">${esc(item.title)}</a></h3>
			<p class="mt-2 flex-1 text-sm leading-relaxed text-body">${esc(item.description)}</p>
			${link}
		</article>`;
	}

	async function runSearch() {
		const q = new URLSearchParams(window.location.search).get('q')?.trim() ?? '';
		if (input) input.value = q;
		if (!q) {
			popularEl?.classList.remove('hidden');
			resultsEl?.classList.add('hidden');
			if (statusEl) statusEl.textContent = '';
			return;
		}
		popularEl?.classList.add('hidden');
		resultsEl?.classList.remove('hidden');
		if (statusEl) statusEl.textContent = 'Searching…';
		let items = [];
		try {
			const res = await fetch('/search-index.json');
			items = await res.json();
		} catch {
			if (statusEl) statusEl.textContent = 'Search is unavailable right now. Please try again.';
			return;
		}
		const needle = q.toLowerCase();
		const hits = items.filter((it) =>
			(it.title + ' ' + it.description + ' ' + it.category + ' ' + (it.tags || '')).toLowerCase().includes(needle)
		);
		const opps = hits.filter((it) => it.type === 'opportunity');
		const guides = hits.filter((it) => it.type === 'guide');
		if (statusEl) statusEl.textContent = `${hits.length} result${hits.length === 1 ? '' : 's'} for “${q}”.`;
		if (noTitle) noTitle.textContent = `No results for “${q}”.`;
		noEl?.classList.toggle('hidden', hits.length > 0);
		if (oppEl) {
			oppEl.innerHTML = opps.length
				? `<h2 class="text-2xl">Opportunities (${opps.length})</h2><div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">${opps.map(card).join('')}</div>`
				: '';
		}
		if (guideEl) {
			guideEl.innerHTML = guides.length
				? `<h2 class="text-2xl">Guides (${guides.length})</h2><div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">${guides.map(card).join('')}</div>`
				: '';
		}
	}

	document.getElementById('search-form')?.addEventListener('submit', (e) => {
		e.preventDefault();
		const q = input?.value.trim() ?? '';
		const url = new URL(window.location.href);
		if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
		window.history.pushState({}, '', url);
		runSearch();
	});

	window.addEventListener('popstate', runSearch);
	runSearch();
</script>
