---
import CategoryPage from '../components/CategoryPage.astro';

// Server-rendered: content comes from the database via CategoryPage (src/lib/content.ts).
export const prerender = false;
---
<CategoryPage
	title="Internships for Fresh Graduates"
	description="Internships for fresh graduates in Pakistan — how to find them, how to apply, and what to expect."
	intro="An internship is the fastest way from a degree to a first job. We explain where real internships are advertised, how to apply, and how to make the most of one."
	oppCategories={['internship']}
	guideCategories={['student', 'career']}
	guideHeading="Student & Career Guides"
	officialLinks={[
		{ label: 'National Job Portal (NJP)', href: 'https://njp.gov.pk/', note: 'Government internships are often listed here.' },
		{ label: 'LinkedIn Jobs', href: 'https://www.linkedin.com/jobs/', note: 'Search "internship Pakistan" for company programmes.' },
		{ label: 'How to apply for internships', href: '/guides/how-to-apply-for-internships-in-pakistan', note: 'Step-by-step application guide.' },
	]}
/>
