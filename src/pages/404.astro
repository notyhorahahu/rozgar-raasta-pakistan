---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The page you are looking for does not exist on Rozgar Raasta Pakistan.">
	<section class="max-w-3xl mx-auto px-4 py-16 text-center">
		<p class="text-6xl font-bold text-brand-600">404</p>
		<h1 class="mt-4 text-3xl md:text-4xl">Page not found</h1>
		<p class="mt-4 text-base leading-relaxed">The page you are looking for may have moved, or the link may be wrong. Try one of these instead:</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a href="/" class="rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white">Go to Home</a>
			<a href="/opportunities" class="rounded-lg border border-line bg-white px-5 py-3 text-sm font-semibold text-navy-900">Latest Opportunities</a>
			<a href="/guides" class="rounded-lg border border-line bg-white px-5 py-3 text-sm font-semibold text-navy-900">All Guides</a>
			<a href="/search" class="rounded-lg border border-line bg-white px-5 py-3 text-sm font-semibold text-navy-900">Search</a>
		</div>
	</section>
</BaseLayout>
