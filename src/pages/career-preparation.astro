		{ label: 'National Job Portal (NJP)', href: 'https://njp.gov.pk/', note: 'Apply for federal government jobs.' },
		{ label: 'LinkedIn Jobs', href: 'https://www.linkedin.com/jobs/', note: 'Build a profile employers actually find.' },
	]}
/>
