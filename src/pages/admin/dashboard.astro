---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { query } from '../../lib/db';
import { getAdminUser, getOrSetCsrfToken } from '../../lib/auth';
import { getDashboardCounts } from '../../lib/content';

// Server-rendered only. Unauthenticated visitors are redirected to
// /admin/login here in the frontmatter (server-side, never a JS redirect).
export const prerender = false;

const user = await getAdminUser(Astro.cookies);
if (!user) {
	return Astro.redirect('/admin/login');
}
const csrfToken = getOrSetCsrfToken(Astro.cookies);

// --- Real data from the database -------------------------------------------
const activeSessions = await query<{ count: string }>(
	`SELECT count(*) AS count FROM sessions WHERE expires_at > now()`,
);
const recentLogs = await query<{
	action: string;
	email: string | null;
	ip: string | null;
	created_at: string;
	details: Record<string, unknown> | null;
}>(
	`SELECT a.action, u.email, a.ip, a.created_at, a.details
	 FROM audit_logs a LEFT JOIN users u ON u.id = a.user_id
	 ORDER BY a.created_at DESC LIMIT 10`,
);

// Real content counts (database first, static fallback — labelled honestly).
const counts = await getDashboardCounts();
const contentSource = counts.source === 'database' ? 'database' : 'static fallback';

const fmtDate = (iso: string) =>
	new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
---

<AdminLayout user={user} csrfToken={csrfToken} title="Dashboard Overview" current="dashboard">
	<!-- Real database stats -->
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		<div class="rounded-lg border border-line bg-white p-5 shadow-sm">
			<p class="truncate text-3xl font-extrabold text-ink">Admin</p>
			<p class="mt-1 truncate text-sm text-muted">{user.email}</p>
		</div>
		<div class="rounded-lg border border-line bg-white p-5 shadow-sm">
			<p class="text-3xl font-extrabold text-ink">{Number(activeSessions.rows[0]?.count ?? 0)}</p>
			<p class="mt-1 text-sm text-muted">Active sessions (database)</p>
		</div>
		<div class="rounded-lg border border-line bg-white p-5 shadow-sm">
			<p class="text-3xl font-extrabold text-ink">{counts.totalOpportunities}</p>
			<p class="mt-1 text-sm text-muted">Opportunities ({contentSource})</p>
		</div>
		<div class="rounded-lg border border-line bg-white p-5 shadow-sm">
			<p class="text-3xl font-extrabold text-ink">{counts.totalGuides}</p>
			<p class="mt-1 text-sm text-muted">Guides ({contentSource})</p>
		</div>
	</div>

	<!-- Content breakdown -->
	<section class="mt-6 rounded-lg border border-line bg-white p-6 shadow-sm">
		<h2 class="text-lg font-extrabold text-ink">Content — {contentSource}</h2>
		<p class="mt-1 text-sm text-muted">
			{counts.source === 'database'
				? 'These numbers are read live from the opportunities and guides tables. Edits in the admin panel appear on the public site immediately.'
				: 'The database could not be reached, so these numbers come from the static files (src/data/opportunities.json and the guides collection). The public site is showing the same fallback.'}
		</p>
		<ul class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
			<li class="flex justify-between border-b border-line pb-2"><span>Total opportunities</span><strong class="text-ink">{counts.totalOpportunities}</strong></li>
			<li class="flex justify-between border-b border-line pb-2"><span>Open opportunities</span><strong class="text-ink">{counts.openOpportunities}</strong></li>
			<li class="flex justify-between border-b border-line pb-2"><span>Closed opportunities</span><strong class="text-ink">{counts.closedOpportunities}</strong></li>
			<li class="flex justify-between border-b border-line pb-2"><span>Unverified opportunities</span><strong class="text-ink">{counts.unverifiedOpportunities}</strong></li>
			<li class="flex justify-between border-b border-line pb-2"><span>Total guides</span><strong class="text-ink">{counts.totalGuides}</strong></li>
			<li class="flex justify-between border-b border-line pb-2"><span>Published guides</span><strong class="text-ink">{counts.publishedGuides}</strong></li>
			<li class="flex justify-between border-b border-line pb-2"><span>Unpublished guides</span><strong class="text-ink">{counts.unpublishedGuides}</strong></li>
		</ul>
		<div class="mt-5 flex flex-wrap gap-3">
			<a href="/admin/jobs" class="rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Manage opportunities →</a>
			<a href="/admin/guides" class="rounded-md border border-line bg-white px-4 py-2 text-sm font-semibold text-ink hover:bg-brand-50">Manage guides →</a>
		</div>
	</section>


	<!-- Recent audit log -->
	<section class="mt-6 rounded-lg border border-line bg-white p-6 shadow-sm">
		<h2 class="text-lg font-extrabold text-ink">Recent security events</h2>
		<p class="mt-1 text-sm text-muted">Latest 10 entries from the audit log (logins, logouts, failed logins, lockouts, content changes).</p>
		{recentLogs.rows.length === 0 ? (
			<p class="mt-4 text-sm">No audit log entries yet.</p>
		) : (
			<div class="mt-4 overflow-x-auto">
				<table class="w-full min-w-[560px] text-left text-sm">
					<thead>
						<tr class="border-b border-line text-xs uppercase tracking-wide text-muted">
							<th class="py-2 pr-3">When</th>
							<th class="py-2 pr-3">Event</th>
							<th class="py-2 pr-3">User</th>
							<th class="py-2">IP</th>
						</tr>
					</thead>
					<tbody>
						{recentLogs.rows.map((log) => (
							<tr class="border-b border-line last:border-0">
								<td class="py-2 pr-3 whitespace-nowrap">{fmtDate(log.created_at)}</td>
								<td class="py-2 pr-3 font-medium text-ink">{log.action}</td>
								<td class="py-2 pr-3">{log.email ?? '—'}</td>
								<td class="py-2">{log.ip ?? '—'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)}
	</section>

	<!-- More sections — coming soon -->
	<section class="mt-6 rounded-lg border border-dashed border-line bg-white p-6 shadow-sm">
		<h2 class="text-lg font-extrabold text-ink">More sections — coming soon</h2>
		<p class="mt-1 text-sm leading-relaxed text-muted">Jobs and Articles are live above. The remaining sections are part of the next milestone — nothing here is demo or fake data.</p>
		<ul class="mt-4 grid gap-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
			{['Manage Categories', 'Manage CV Builder Templates', 'Manage Newsletter Subscribers', 'Manage Contact Messages', 'Manage Users', 'SEO Management', 'Website Settings', 'Analytics', 'Security Logs', 'Admin Profile', 'Backup and Recovery'].map((name) => (
				<li class="flex items-center justify-between rounded-md bg-cream px-3 py-2">
					<span class="font-medium text-ink">{name}</span>
					<span class="rounded-full bg-white px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted">Coming soon</span>
				</li>
			))}
		</ul>
	</section>
</AdminLayout>
