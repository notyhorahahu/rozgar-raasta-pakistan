---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import GuideForm from '../../../components/admin/GuideForm.astro';
import { getAdminUser, getOrSetCsrfToken } from '../../../lib/auth';

export const prerender = false;

const user = await getAdminUser(Astro.cookies);
if (!user) {
	return Astro.redirect('/admin/login');
}
const csrfToken = getOrSetCsrfToken(Astro.cookies);
---

<AdminLayout user={user} csrfToken={csrfToken} title="New Guide" current="articles">
	<p class="mb-4 text-sm text-muted">
		<a href="/admin/guides" class="font-semibold text-brand-700 hover:underline">← All guides</a>
	</p>
	<GuideForm csrfToken={csrfToken} />
</AdminLayout>
