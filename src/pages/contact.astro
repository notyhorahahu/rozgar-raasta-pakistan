---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Us" description="Contact Rozgar Raasta Pakistan — corrections, tips about fake jobs, advertising enquiries and general questions.">
	<section class="max-w-3xl mx-auto px-4 py-12">
		<h1 class="text-3xl md:text-4xl">Contact Us</h1>
		<p class="mt-4 text-base leading-relaxed">Questions, corrections, or a tip about a fake job listing? Send us a message. We read every message and reply to genuine enquiries.</p>
		<p class="mt-3 text-sm text-muted">Please do not send CNIC numbers, bank details or passwords. We will never ask for them.</p>
		<form id="contact-form" class="mt-8 space-y-5 rounded-md border border-line bg-white p-6 shadow-sm" novalidate>
			<div>
				<label for="c-name" class="text-sm font-semibold text-navy-900">Your name *</label>
				<input id="c-name" type="text" required placeholder="Your full name" class="mt-1 w-full border border-line px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
			</div>
			<div>
				<label for="c-email" class="text-sm font-semibold text-navy-900">Email address *</label>
				<input id="c-email" type="email" required placeholder="you@example.com" class="mt-1 w-full border border-line px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
			</div>
			<div>
				<label for="c-topic" class="text-sm font-semibold text-navy-900">Topic</label>
				<select id="c-topic" class="mt-1 w-full border border-line px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600">
					<option>General question</option>
					<option>Correction to a listing or article</option>
					<option>Report a fake job or scam</option>
					<option>Advertising enquiry</option>
					<option>Something else</option>
				</select>
			</div>
			<div>
				<label for="c-message" class="text-sm font-semibold text-navy-900">Message *</label>
				<textarea id="c-message" rows="5" required placeholder="Write your message here. If you are reporting a listing, include the page link." class="mt-1 w-full border border-line px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600"></textarea>
			</div>
			<button type="submit" class=" bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700">Send message</button>
			<p id="contact-msg" class="hidden text-sm" role="status"></p>
			<p class="text-xs text-muted">This form opens your email app with the message ready to send. We do not store form submissions on our servers.</p>
		</form>
	</section>
</BaseLayout>
<script>
	const form = document.getElementById('contact-form');
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const name = (document.getElementById('c-name') as HTMLInputElement).value.trim();
		const email = (document.getElementById('c-email') as HTMLInputElement).value.trim();
		const topic = (document.getElementById('c-topic') as HTMLSelectElement).value;
		const message = (document.getElementById('c-message') as HTMLTextAreaElement).value.trim();
		const msg = document.getElementById('contact-msg');
		if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || !message) {
			if (msg) { msg.textContent = 'Please fill in your name, a valid email address and a message.'; msg.classList.remove('hidden'); msg.className = 'text-sm text-red-600'; }
			return;
		}
		const subject = encodeURIComponent(`[Rozgar Raasta] ${topic} — ${name}`);
		const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
		window.location.href = `mailto:hello@rozgar-raasta-pakistan.vercel.app?subject=${subject}&body=${body}`;
		if (msg) { msg.textContent = 'Your email app should now open with the message ready to send.'; msg.classList.remove('hidden'); msg.className = 'text-sm text-emerald-700'; }
	});
</script>
