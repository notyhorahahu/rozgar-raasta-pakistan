# Rozgar Raasta Pakistan — environment variables
# Copy to .env and fill in real values. NEVER commit a real .env.
# .env is gitignored. DATABASE_URL is read by src/lib/db.ts.

# Local testing (PostgreSQL 16 on this machine):
DATABASE_URL=postgresql://rozgar:CHANGE_ME@127.0.0.1:5432/rozgar_test

# Production (Neon pooled connection string, set in Vercel env vars):
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require

# One-time first Super Admin creation only (scripts/create-admin.mjs).
# Set these in Vercel env vars for the one-time init, then REMOVE
# ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
